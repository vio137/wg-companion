{
  "manifest_version": 3,
  "name": "WireGuard Companion",
  "version": "0.2.0",
  "description": "Route Chrome through a WireGuard tunnel run by the bundled local wg-companion.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["proxy", "nativeMessaging", "storage", "privacy", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "WireGuard Companion",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png" } },
  "icons": { "16": "icons/on16.png", "48": "icons/on48.png", "128": "icons/on128.png" }
}
